; Engine configuration file.
config_version=5

[application]

config/name="Gridiron Career"
config/description="Gridiron Career: American football, eleven a side, where every coach, play and position brain is a short readable rule file you can edit in the browser."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.025, 0.05, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1

[audio]

general/text_to_speech=true
